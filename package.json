{
  "name": "wuelev8-smart-proctoring-browser",
  "version": "1.0.0",
  "description": "WUElev8 Smart Proctoring Browser - Dedicated Assessment Environment",
  "main": "electron/main.js",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:electron": "node electron/run.js",
    "seed": "npm --prefix server run seed",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client",
    "build:all": "npm run build:client && npm run build:server",
    "test": "npm --prefix server test",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT,ELECTRON\" -c \"cyan,magenta,green\" \"npm run dev:server\" \"npm run dev:client\" \"node electron/run.js\"",
    "start:app": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "package:dir": "npm run build:client && electron-builder --dir --win --x64",
    "package:win": "npm run build:client && electron-builder --win nsis --x64",
    "build:installer": "npm run package:win"
  },
  "keywords": [
    "proctoring",
    "electron",
    "react",
    "ai",
    "hackathon",
    "wuelev8"
  ],
  "author": "WUElev8 Innovation Services Pvt. Ltd.",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.wuelev8.smartproctoringbrowser",
    "productName": "WUElev8 Smart Proctoring Browser",
    "copyright": "Copyright © 2026 WUElev8 Innovation Services Pvt. Ltd.",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/assets",
        "to": "assets"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "electron/get-foreground-window.ps1",
      "electron/assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WUElev8 Smart Proctoring Browser"
    }
  }
}